{
  "name": "@zhexusun10/pi-timeout",
  "version": "0.1.0",
  "description": "Pi coding agent extension that sets a configurable default timeout (180s) for the bash tool, updates the bash schema timeout description, prefixes default timeout returns, and lets users adjust the timeout in the TUI.",
  "type": "module",
  "license": "MIT",
  "author": "Jerry (zhexusun10)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhexusun10/pi-timeout.git"
  },
  "bugs": {
    "url": "https://github.com/zhexusun10/pi-timeout/issues"
  },
  "homepage": "https://github.com/zhexusun10/pi-timeout#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "bash",
    "timeout",
    "coding-agent"
  ],
  "files": [
    "extensions/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "22.19.19",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "verify:load": "node scripts/verify-install.mjs",
    "build": "npm run check && npm test && npm run verify:load && npm pack",
    "prepublishOnly": "npm run check && npm test && npm run verify:load"
  }
}
